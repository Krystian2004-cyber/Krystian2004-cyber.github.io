{% extends 'base.html.twig' %}

{% block title %}Movie index{% endblock %}

{% block body %}
    <h1>Movie Library</h1>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-primary">
                <tr>
                    <th>Id</th>
                    <th>Title</th>
                    <th>Director</th>
                    <th>Year</th>
                    <th class="d-none d-md-table-cell">Description</th>
                    <th>Rating</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for movie in movies %}
                <tr>
                    <td>{{ movie.id }}</td>
                    <td class="movie-title">{{ movie.title }}</td>
                    <td>{{ movie.director }}</td>
                    <td>{{ movie.year }}</td>
                    <td class="d-none d-md-table-cell text-muted small">{{ movie.description|slice(0, 50) }}...</td>
                    <td><span class="badge bg-info text-dark">{{ movie.rating }}</span></td>
                    <td>
                        <a href="{{ path('app_movie_show', {'id': movie.id}) }}" class="btn btn-sm btn-outline-primary">Show</a>
                        <a href="{{ path('app_movie_edit', {'id': movie.id}) }}" class="btn btn-sm btn-outline-secondary">Edit</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="text-center">No movies found.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <a href="{{ path('app_movie_new') }}" class="btn btn-success mt-3">Add New Movie</a>
{% endblock %}
