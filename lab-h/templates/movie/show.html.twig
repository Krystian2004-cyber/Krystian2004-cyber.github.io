{% extends 'base.html.twig' %}

{% block title %}Movie{% endblock %}

{% block body %}
    <h1>Movie Details</h1>

    <div class="card mb-4">
        <div class="card-body">
            <table class="table">
                <tbody>
                    <tr>
                        <th style="width: 200px;">Id</th>
                        <td>{{ movie.id }}</td>
                    </tr>
                    <tr>
                        <th>Title</th>
                        <td class="movie-title">{{ movie.title }}</td>
                    </tr>
                    <tr>
                        <th>Director</th>
                        <td>{{ movie.director }}</td>
                    </tr>
                    <tr>
                        <th>Year</th>
                        <td>{{ movie.year }}</td>
                    </tr>
                    <tr>
                        <th>Description</th>
                        <td>{{ movie.description }}</td>
                    </tr>
                    <tr>
                        <th>Rating</th>
                        <td><span class="badge bg-primary">{{ movie.rating }}</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 mb-4">
        <a href="{{ path('app_movie_index') }}" class="btn btn-secondary">Back to list</a>
        <a href="{{ path('app_movie_edit', {'id': movie.id}) }}" class="btn btn-warning">Edit</a>
        {{ include('movie/_delete_form.html.twig') }}
    </div>
{% endblock %}
