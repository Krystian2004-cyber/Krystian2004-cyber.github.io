<%- include('../header', {title: 'Movie index'}) %>

<h1>Movie Library</h1>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-primary">
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Director</th>
                <th>Year</th>
                <th class="d-none d-md-table-cell">Description</th>
                <th>Rating</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        <% if (movies.length > 0) { %>
            <% movies.forEach(function(movie) { %>
                <tr>
                    <td><%= movie.id %></td>
                    <td class="movie-title"><%= movie.title %></td>
                    <td><%= movie.director %></td>
                    <td><%= movie.year %></td>
                    <td class="d-none d-md-table-cell text-muted small"><%= movie.description.substring(0, 50) %>...</td>
                    <td><span class="badge bg-info text-dark"><%= movie.rating %></span></td>
                    <td>
                        <a href="/movies/<%= movie.id %>" class="btn btn-sm btn-outline-primary">Show</a>
                        <a href="/movies/<%= movie.id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
                    </td>
                </tr>
            <% }); %>
        <% } else { %>
            <tr>
                <td colspan="7" class="text-center">No movies found.</td>
            </tr>
        <% } %>
        </tbody>
    </table>
</div>

<a href="/movies/new" class="btn btn-success mt-3">Add New Movie</a>

<%- include('../footer') %>
