<%- include('../header', {title: 'Movies List', bodyClass: 'index'}) %>

<h1>Movies List</h1>

<a href="/movies/new">Create new</a>

<ul class="index-list">
    <% if (movies.length > 0) { %>
        <% movies.forEach(function(movie) { %>
            <li>
                <h3><%= movie.title %> [Rating: <%= movie.rating %>/10]</h3>
                <ul class="action-list">
                    <li><a href="/movies/<%= movie.id %>">Details</a></li>
                    <li><a href="/movies/<%= movie.id %>/edit">Edit</a></li>
                </ul>
            </li>
        <% }); %>
    <% } else { %>
        <li>No movies found.</li>
    <% } %>
</ul>

<p>Total movies: <%= movies.length %></p>

<%- include('../footer') %>
