<%- include('../header', {title: 'Movie'}) %>

<h1>Movie Details</h1>

<div class="card mb-4">
    <div class="card-body">
        <table class="table">
            <tbody>
                <tr>
                    <th style="width: 200px;">Id</th>
                    <td><%= movie.id %></td>
                </tr>
                <tr>
                    <th>Title</th>
                    <td class="movie-title"><%= movie.title %></td>
                </tr>
                <tr>
                    <th>Director</th>
                    <td><%= movie.director %></td>
                </tr>
                <tr>
                    <th>Year</th>
                    <td><%= movie.year %></td>
                </tr>
                <tr>
                    <th>Description</th>
                    <td><%= movie.description %></td>
                </tr>
                <tr>
                    <th>Rating</th>
                    <td><span class="badge bg-primary"><%= movie.rating %></span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex flex-wrap gap-2 mb-4">
    <a href="/movies" class="btn btn-secondary">Back to list</a>
    <a href="/movies/<%= movie.id %>/edit" class="btn btn-warning">Edit</a>
    
    <form method="post" action="/movies/<%= movie.id %>/delete" onsubmit="return confirm('Are you sure you want to delete this item?');" style="display: inline-block;">
        <button class="btn btn-danger">Delete</button>
    </form>
</div>

<%- include('../footer') %>
