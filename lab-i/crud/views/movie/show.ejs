<%- include('../header', {title: movie.title, bodyClass: 'show'}) %>

<h1><%= movie.title %></h1>

<article>
    <p>Director: <%= movie.director %></p>
    <p>Year: <%= movie.year %></p>
    <p>Rating: <%= movie.rating %>/10</p>
    <p><%= movie.description %></p>
</article>

<ul class="action-list">
    <li><a href="/movies">Back to list</a></li>
    <li><a href="/movies/<%= movie.id %>/edit">Edit</a></li>
    <li>
        <form method="post" action="/movies/<%= movie.id %>/delete" onsubmit="return confirm('Are you sure you want to delete this item?');" style="display: inline;">
            <button type="submit" style="background: none; border: none; padding: 0; color: #484848; font: inherit; cursor: pointer; text-decoration: none;">Delete</button>
        </form>
    </li>
</ul>

<%- include('../footer') %>
